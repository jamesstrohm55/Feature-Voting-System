# ── Database ──────────────────────────────────────────────────────────────────
# Supabase Postgres: find this under Project Settings → Database → Connection string → URI.
# Use the "Session mode" (port 5432) connection string for Django.
# Example: postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# For local development without Supabase, omit this line — Django falls back to SQLite.
DATABASE_URL=postgres://postgres.[ref]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_API_KEY=your-supabase-api-key-here
# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins. The Vite dev server runs on 5173 by default.
CORS_ALLOWED_ORIGINS=http://localhost:5173
